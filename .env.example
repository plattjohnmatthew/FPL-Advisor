# Public deployment: APP_MODE=public_read_only and this public, read-only data location.
# PUBLIC_SNAPSHOT_BASE_URL=https://<store-id>.public.blob.vercel-storage.com/fpl-research/
# LOCAL publisher ONLY. Never add this token to the public Vercel project:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Optional isolated local build output (must remain inside this repository):
# FPL_NEXT_DIST_DIR=.next-public-check

# Public showcase links and optional squad publication (off by default).
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/plattjohnmatthew/FPL-Advisor
# PUBLISH_PUBLIC_SQUAD=true opts the saved entry ID/name and picks into a new snapshot.
# PUBLIC_SHOW_SQUAD=true displays that published squad. Leave both unset by default.

# One codebase, separate deployments. Never publish private mode.
APP_MODE=private
# Public deployment needs no Supabase/API credentials. Generate local files first:
# APP_MODE=private npm run publish:public
# See docs/PUBLIC_SNAPSHOTS.md.

# Public Supabase project URL. This value is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
OPENAI_API_KEY=your-openai-api-key
# Server-only task model policy. Invalid overrides fail; no task escalates to a frontier alias.
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_QUERY_MODEL=gpt-5.6-luna
OPENAI_SPLIT_MODEL=gpt-5.6-luna
OPENAI_SYNTHESIS_MODEL=gpt-5.4-mini
OPENAI_SYNTHESIS_REDUCTION_MODEL=gpt-5.6-luna
OPENAI_CHAT_MODEL=gpt-5.4-mini
SYNTHESIS_MAX_INPUT_TOKENS=180000
SYNTHESIS_REDUCTION_MAX_INPUT_TOKENS=80000
SYNTHESIS_RESERVED_OUTPUT_TOKENS=12000
SYNTHESIS_SAFETY_MARGIN_TOKENS=40000
SYNTHESIS_CONTEXT_WINDOW_TOKENS=400000
SYNTHESIS_REDUCTION_CONTEXT_WINDOW_TOKENS=400000

# Server-side configured bounds used by the chat "This season" scope.
FPL_SEASON_START_DATE=2026-08-01
FPL_SEASON_END_DATE=2027-05-31

# Public FPL manager entry/team ID. Configuration, not a secret.
FPL_ENTRY_ID=

# Server-only transcript acquisition. Never prefix SUPADATA_API_KEY with NEXT_PUBLIC_.
TRANSCRIPT_PROVIDER_PRIMARY=supadata
TRANSCRIPT_PROVIDER_FALLBACK=youtube_local
YOUTUBE_TRANSCRIPT_PYTHON_COMMAND=python
SUPADATA_API_KEY=your-supadata-api-key
SUPADATA_ALLOW_AI_FALLBACK=false
