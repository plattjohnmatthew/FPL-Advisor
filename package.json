{
  "name": "fpl-research",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/**/*.test.ts",
    "import:test-transcript": "tsx --conditions=react-server scripts/import-test-transcript.ts",
    "verify:youtube-discovery": "tsx --conditions=react-server scripts/verify-youtube-discovery.ts",
    "diagnose:persistence": "tsx --conditions=react-server scripts/diagnose-persistence.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:stop": "supabase stop"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "fast-xml-parser": "^5.10.1",
    "next": "latest",
    "openai": "^7.4.0",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "supabase": "2.113.0",
    "tsx": "4.23.11",
    "typescript": "latest"
  }
}
