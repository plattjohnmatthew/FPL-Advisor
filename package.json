{
  "name": "fpl-research",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/**/*.test.ts",
    "import:test-transcript": "tsx --conditions=react-server scripts/import-test-transcript.ts",
    "verify:youtube-discovery": "tsx --conditions=react-server scripts/verify-youtube-discovery.ts",
    "diagnose:persistence": "tsx --conditions=react-server scripts/diagnose-persistence.ts",
    "report:transcript-usage": "tsx --conditions=react-server scripts/report-transcript-usage.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "publish:public": "tsx --conditions=react-server scripts/publish-public-snapshot.ts",
    "build:public": "node scripts/build-public.mjs",
    "validate:public-data": "tsx --conditions=react-server scripts/validate-public-data.ts",
    "check:public-bundle": "tsx --conditions=react-server scripts/check-public-bundle.ts",
    "publish:public-data": "tsx --conditions=react-server scripts/publish-public-snapshot.ts --upload",
    "rollback:public-data": "tsx --conditions=react-server scripts/rollback-public-data.ts",
    "check:public-http": "node scripts/check-public-http.mjs",
    "audit:public-secrets": "tsx --conditions=react-server scripts/audit-public-secrets.ts",
    "audit:public-endpoints": "tsx --conditions=react-server scripts/audit-public-endpoints.ts",
    "audit:repository": "node scripts/audit-repository.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "fast-xml-parser": "^5.10.1",
    "js-tiktoken": "^1.0.21",
    "next": "^16.4.4",
    "openai": "^7.4.0",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vercel/blob": "^2.8.2",
    "eslint": "latest",
    "eslint-config-next": "^16.4.4",
    "supabase": "2.113.0",
    "tsx": "4.23.11",
    "typescript": "latest"
  }
}
